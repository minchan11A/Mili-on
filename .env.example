# 실행 모드: server(기본) | demo
NEXT_PUBLIC_APP_MODE=server
# 로컬·Railway: 두 값을 같게. Supabase: DATABASE_URL은 풀러(6543, ?pgbouncer=true), DIRECT_URL은 직접 연결(5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/milind
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/milind
SESSION_SECRET=change-me-to-a-long-random-string
# claude | gemini | openai  (키가 없으면 사전 생성 캐시로 대체)
LLM_PROVIDER=claude
LLM_API_KEY=
# 선택: 공급자별 모델 이름 덮어쓰기
LLM_MODEL=
