{
  "name": "milind",
  "version": "0.1.0",
  "private": true,
  "description": "밀라인드: 예비군 훈련장 만족도·개선 제안·AI 대책 플랫폼 (2026 예비전력분야 혁신 아이디어 공모전)",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "cross-env NEXT_PUBLIC_APP_MODE=demo next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "build:demo": "cross-env NEXT_PUBLIC_APP_MODE=demo next build && tsx scripts/check-external-urls.ts",
    "serve:demo": "serve out -l 4173",
    "ai-cache": "tsx --conditions react-server scripts/build-ai-cache.ts",
    "masking:eval": "tsx scripts/masking-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "seed:generate": "python3 seed/scripts/generate_seed.py && python3 seed/scripts/validate_seed.py && tsx scripts/build-cache-drafts.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "next": "^15.5.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.29",
    "prisma": "^6.19.0",
    "seedrandom": "^3.0.5",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
